# Copier en .env.local pour le développement. Sur Vercel : Settings → Environment Variables.
# Ne jamais committer de vraies valeurs.

# ── Site ────────────────────────────────────────────────────────────────
# URL publique, sans slash final. Sert aux URL canoniques, à robots.txt et aux événements Plausible.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Garde-fou de contenu ────────────────────────────────────────────────
# Le build échoue s'il reste du contenu factice (isPlaceholder) ou un lien d'affiliation manquant
# quand VERCEL_ENV=production (posé automatiquement par Vercel) ou quand cette variable vaut true.
# Utile pour tester le blocage en local, ou si le site est hébergé ailleurs que sur Vercel.
BLOCK_PLACEHOLDERS=false

# ── Plausible ───────────────────────────────────────────────────────────
# Domaine du site tel que déclaré dans Plausible. Vide = aucune mesure.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Script de mesure (Plausible fournit parfois une URL propre au site, ex. https://plausible.io/js/pa-XXXX.js).
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
# Événements serveur « Affiliate Click » envoyés par /go/[tool] (API Events). Vide = désactivé.
PLAUSIBLE_DOMAIN=
# À changer seulement pour une instance Plausible auto-hébergée.
PLAUSIBLE_API_HOST=https://plausible.io

# ── Liens d'affiliation ─────────────────────────────────────────────────
# Une variable par outil dont partnerProgram vaut "affiliation" dans src/data/tools.ts.
# Nom : AFFILIATE_URL_ + slug en majuscules, tirets remplacés par « _ ». URL en https uniquement.
# Sans URL valide, /go/<slug> répond 404 (et le build de production échoue).
AFFILIATE_URL_EXEMPLE_CAISSE_A=
AFFILIATE_URL_EXEMPLE_TPE_B=
